@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#f5f7fa;--card:#fff;--ink:#14283b;--muted:#718196;--blue:#1266db;--blue2:#08489c;--line:#e2e8f0;--dark:#091726;--accent:#35a8ff}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--ink);transition:.3s;line-height:1.6}
body.dark{--bg:#081421;--card:#102235;--ink:#ecf4ff;--muted:#9cb0c5;--line:#23394f;--blue:#4b9cff;--blue2:#2476d8}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer;color:inherit}
.topline{height:32px;background:#081726;color:#c7d8ea;display:flex;justify-content:space-between;padding:0 6%;font-size:11px;letter-spacing:1px}
.topline span:first-child{color:#65c6ff}
.header{height:88px;display:flex;align-items:center;justify-content:space-between;padding:0 5%;background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.brand{display:flex;align-items:center;min-width:150px}
.logo-img{max-width:175px;max-height:65px;object-fit:contain}
.logo-text{font-family:Manrope;font-size:20px;font-weight:800;letter-spacing:1px}
.logo-text b{color:var(--blue)}
.nav{display:flex;gap:30px;font-size:13px;font-weight:600}
.nav a:hover{color:var(--blue)}
.head-actions{display:flex;align-items:center;gap:10px}
.small-btn{border:1px solid var(--line);background:var(--card);border-radius:10px;padding:10px 13px}
.small-btn:hover{border-color:var(--blue);color:var(--blue)}
.cta{display:inline-flex;align-items:center;justify-content:center;background:var(--blue);color:white;border-radius:10px;padding:14px 20px;font-weight:700;transition:.25s;border:0}
.cta:hover{background:var(--blue2);transform:translateY(-2px)}
.small-cta{padding:10px 14px;font-size:12px}
.dropdown{position:relative}
.drop-menu{display:none;position:absolute;top:46px;right:0;background:var(--card);border:1px solid var(--line);border-radius:12px;min-width:145px;box-shadow:0 15px 35px #0002;overflow:hidden;z-index:30}
.drop-menu.open{display:block}
.drop-menu button{display:block;width:100%;padding:12px;text-align:left;background:none;border:0}
.drop-menu button:hover{background:var(--bg)}
.mobile-btn,.mobile-nav{display:none}
.hero{min-height:600px;background:linear-gradient(90deg,#071728f5 0%,#071728db 45%,#07172833 100%),url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1800&q=85') center/cover;color:white;padding:100px 8%;display:flex;align-items:center}
.hero-content{max-width:760px}
.eyebrow{color:#60b9ff;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase}
.hero h1{font-family:Manrope;font-size:clamp(42px,6vw,76px);line-height:1.08;margin:20px 0;font-weight:800}
.hero h1 span{color:#5db7ff}
.hero p{color:#c6d4e4;max-width:580px;font-size:17px}
.hero-buttons{display:flex;gap:15px;margin-top:32px;flex-wrap:wrap}
.btn-outline{border:1px solid #ffffff60;border-radius:10px;padding:14px 20px}
.btn-outline:hover{background:#ffffff14}
.stats{display:grid;grid-template-columns:repeat(4,1fr);background:var(--card);border:1px solid var(--line);border-radius:18px;padding:30px;margin:-45px 6% 60px;position:relative;box-shadow:0 15px 40px #0001}
.stat strong{display:block;font-family:Manrope;font-size:32px;color:var(--blue)}
.stat small{color:var(--muted)}
.section{padding:75px 7%}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:35px;flex-wrap:wrap}
.section-head h2{font-family:Manrope;font-size:clamp(28px,4vw,42px);line-height:1.2}
.section-head p{max-width:480px;color:var(--muted)}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:25px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.3s}
.card:hover{transform:translateY(-5px);box-shadow:0 20px 45px #0001}
.card-img{width:100%;height:240px;object-fit:cover}
.card-body{padding:25px}
.card-body h3{font-family:Manrope;margin-bottom:12px;font-size:21px}
.card-body p{color:var(--muted);font-size:14px}
.card-body a{display:inline-block;margin-top:18px;color:var(--blue);font-weight:700}
.icon-box{width:52px;height:52px;background:#e5f2ff;color:#1473dd;border-radius:15px;display:grid;place-items:center;font-size:23px;margin-bottom:20px}
body.dark .icon-box{background:#183b60}
.service-card{padding:30px}
.service-card h3{font-size:20px;margin-bottom:10px}
.service-card p{color:var(--muted);font-size:14px}
.service-card a{display:inline-block;color:var(--blue);margin-top:15px;font-weight:700}
.band{background:#0b1c2e;color:white;padding:75px 7%;display:flex;justify-content:space-between;align-items:center;gap:35px;flex-wrap:wrap}
.band h2{font-family:Manrope;font-size:36px;max-width:650px}
.band p{color:#aebfd1;margin-top:10px}
.page-hero{background:linear-gradient(120deg,#0a1b2d,#163b60);color:white;padding:80px 7%}
.page-hero h1{font-family:Manrope;font-size:50px}
.page-hero p{color:#c5d5e5;max-width:650px;margin-top:10px}
.breadcrumb{font-size:12px;color:#72baff;margin-bottom:15px}
.feature-list{display:grid;gap:15px;margin-top:20px}
.feature{display:flex;gap:14px;padding:18px;background:var(--card);border:1px solid var(--line);border-radius:14px}
.feature span{color:var(--blue);font-weight:800}
.project-image{height:280px;object-fit:cover;width:100%}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}
.contact-box{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:30px}
input,textarea,select{width:100%;padding:14px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);margin-top:6px;font-family:inherit}
label{font-weight:600;font-size:13px;display:block;margin-top:15px}
textarea{min-height:140px}
.footer{background:#081726;color:#d4e0ec;padding:60px 7% 25px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:35px}
.footer-logo{margin-bottom:15px}
.footer p{color:#a7b8ca;margin:8px 0;font-size:14px}
.footer a{display:block;margin:10px 0;color:#c4d5e5}
.footer-bottom{border-top:1px solid #253a4f;margin-top:40px;padding-top:20px;color:#879bb1;font-size:12px}
.overlay{display:none;position:fixed;inset:0;background:#0008;z-index:40}
.overlay.open{display:block}
.panel{position:fixed;right:0;top:0;height:100%;width:min(440px,95vw);background:var(--card);z-index:41;padding:35px;transform:translateX(100%);transition:.3s;overflow:auto}
.panel.open{transform:translateX(0)}
.close{float:right;border:0;background:none;font-size:22px}
.panel h2{font-family:Manrope;margin:35px 0 15px}
.panel p{color:var(--muted)}
.panel button.option{display:block;width:100%;padding:14px;text-align:left;margin:10px 0;background:var(--bg);border:1px solid var(--line);border-radius:10px}
.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#0b1c2e;color:white;padding:12px 20px;border-radius:12px;display:none;z-index:50}
.toast.show{display:block}
.faq{padding:20px;border:1px solid var(--line);background:var(--card);border-radius:12px;margin:10px 0}
.faq button{background:none;border:0;width:100%;text-align:left;font-weight:700;font-size:16px}
.faq p{display:none;color:var(--muted);padding-top:12px}
.faq.open p{display:block}
.search-field{font-size:17px}
[dir=rtl] .nav{direction:rtl}
[dir=rtl] .panel{right:auto;left:0;transform:translateX(-100%)}
[dir=rtl] .panel.open{transform:translateX(0)}
@media(max-width:1100px){.nav{gap:15px}.head-actions{gap:5px}.small-cta{display:none}}
@media(max-width:800px){.nav{display:none}.mobile-btn{display:block;border:1px solid var(--line);background:var(--card);padding:10px;border-radius:10px}.mobile-nav{display:none;background:var(--card);padding:20px;position:sticky;top:88px;z-index:19;border-bottom:1px solid var(--line)}.mobile-nav.open{display:grid;gap:14px}.hero{padding:75px 7%;min-height:520px}.stats{grid-template-columns:repeat(2,1fr);gap:25px}.grid3{grid-template-columns:1fr 1fr}.contact-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.grid3,.grid2{grid-template-columns:1fr}.hero h1{font-size:44px}.section{padding:55px 6%}.page-hero h1{font-size:36px}.header{padding:0 4%}.stats{margin-left:4%;margin-right:4%;padding:22px}.footer-grid{grid-template-columns:1fr}.head-actions{gap:4px}.small-btn{padding:8px}}
